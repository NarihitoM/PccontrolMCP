{
  "name": "pc-mcp-by-narihito",
  "version": "1.0.0",
  "description": "MCP server to control a Windows PC from AI tools: screen, mouse, keyboard, windows, apps and system controls, with one-command setup",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pc-mcp": "dist/index.js",
    "pc-mcp-by-narihito": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "bridge",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm test",
    "setup": "node dist/index.js setup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsc && node --test dist/**/*.test.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows",
    "pc",
    "laptop",
    "computer-use",
    "automation",
    "ui-automation",
    "claude",
    "cursor",
    "ai-agent"
  ],
  "author": "NarihitoM",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NarihitoM/PccontrolMCP.git"
  },
  "bugs": {
    "url": "https://github.com/NarihitoM/PccontrolMCP/issues"
  },
  "homepage": "https://github.com/NarihitoM/PccontrolMCP#readme",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
